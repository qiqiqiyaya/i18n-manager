# ── i18n Manager 环境变量模板 ──
# 复制为 .env.local 后按需修改。所有变量均为非敏感配置，无密钥。

# 自动保存防抖延迟（毫秒）。编辑器 onChange 经 RxJS debounceTime 后触发保存。
NEXT_PUBLIC_AUTO_SAVE_DEBOUNCE=1000

# 键级锁定超时（毫秒）。超时后 WebSocket 自动释放锁。
LOCK_TIMEOUT=30000

# 前端 Socket.IO 连接地址。
NEXT_PUBLIC_WS_URL=http://localhost:3000

# 数据持久化根目录，项目文件写入 {DATA_DIR}/projects/{projectId}/。
DATA_DIR=./data

# HTTP/WebSocket 监听端口（server.ts 使用，默认 3000）。
# PORT=3000
