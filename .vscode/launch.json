{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Server",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "--require",
                "./fix-async-storage.cjs",
                "--import",
                "tsx",
                "server.ts"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "env": {
                "NODE_ENV": "development",
                "PORT": "3000",
                "DATA_DIR": "./data"
            },
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}