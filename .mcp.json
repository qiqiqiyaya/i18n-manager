{
    "mcpServers": {
        "next-devtools": {
            "command": "npx",
            "args": [
                "-y",
                "next-devtools-mcp@latest"
            ]
        },
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp@latest",
                "--api-key",
                "i18nManager"
            ],
            "description": "实时文档查询 — Next.js/React/Express 等库文档"
        },
        "playwright": {
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp",
                "--browser",
                "chrome"
            ],
            "description": "浏览器自动化与 E2E 测试"
        }
    }
}